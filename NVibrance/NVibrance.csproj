<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <ApplicationIcon>ui\Assets\logo.ico</ApplicationIcon>
        <!-- Program.Main runs Velopack's install/update hooks before WPF starts -->
        <StartupObject>NVibrance.Program</StartupObject>
    </PropertyGroup>

    <ItemGroup>
        <!-- compile App.xaml as a page so WPF doesn't generate a competing Main -->
        <ApplicationDefinition Remove="App.xaml" />
        <Page Include="App.xaml" />
    </ItemGroup>
    
    <PropertyGroup>
        <!-- Build configuration -->
        <Optimize>true</Optimize>
        <DebugType>portable</DebugType>
        <Deterministic>true</Deterministic>

        <!-- Release builds override this from the git tag; see .github/workflows/release.yml -->
        <Version>1.0.0</Version>
        <Product>NVibrance</Product>
        <Description>NVibrance — per-application NVIDIA digital vibrance profiles</Description>
        <Company>PanamaP</Company>
        
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>     <!-- or win-x86 -->
        <PublishReadyToRun>true</PublishReadyToRun>       <!-- improve startup -->
        <PublishSingleFile>true</PublishSingleFile>       <!-- optional -->
        <OptimizationPreference>Speed</OptimizationPreference>
    </PropertyGroup>

    <ItemGroup>
      <Page Update="UI\MainWindow.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="NvAPIWrapper.Net" Version="0.8.1.101" />
      <!-- release.yml installs the vpk tool at this same version -->
      <PackageReference Include="Velopack" Version="1.2.158" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="NVibrance.Tests" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="ui\Assets\logo.png" />
        <Resource Include="ui\Assets\logo.ico" />
    </ItemGroup>

</Project>
