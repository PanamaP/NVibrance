<!-- File: `NVibrance/UI/MainWindow.xaml` -->
<Window x:Class="NVibrance.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:NVibrance"
        xmlns:vm="clr-namespace:NVibrance.ViewModels"
        mc:Ignorable="d"
        Title="NVibrance"
        Width="900"
        Height="600"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource TextFont}"
        FontSize="14"
        PreviewKeyDown="Window_PreviewKeyDown"
        Icon="pack://application:,,,/ui/Assets/logo.ico">

    <shell:WindowChrome.WindowChrome>
        <!-- GlassFrameThickness becomes -1 at runtime when the Mica backdrop is available -->
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- colour and font tokens live in Theme.xaml, shared with the tray menu -->

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- ===== Type ramp ===== -->
        <Style x:Key="CaptionText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>

        <Style x:Key="BodyStrongText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TitleText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style x:Key="IconText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- ===== Keyboard focus ===== -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3"
                                BorderThickness="2"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource FocusRingBrush}"
                                SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="{DynamicResource PopupBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- ===== Buttons ===== -->
        <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="{x:Type Button}">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="AppButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                </Trigger>
                <!-- pressed state lands on mouse-down, not on release -->
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource AppButtonStyle}" />

        <Style x:Key="AccentButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AppButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubtleButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AppButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverFillBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PressedFillBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AppButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Windows 11 caption buttons: 46×32, square, flush to the top-right corner -->
        <Style x:Key="CaptionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverFillBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PressedFillBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CloseHoverBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource CloseHoverTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Text input ===== -->
        <!-- the profile name: reads as a title until hovered or focused -->
        <Style x:Key="TitleEditBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="-8,0,0,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <!-- TextBox applies Padding to the content host itself; binding it here too doubles it -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Padding" Value="32,6,8,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <TextBlock Style="{StaticResource IconText}"
                                           Text="&#xE721;"
                                           FontSize="12"
                                           Margin="10,0,0,0"
                                           HorizontalAlignment="Left"
                                           Foreground="{DynamicResource MutedBrush}" />
                                <!-- matches Padding plus the 2px the text view insets the caret -->
                                <TextBlock x:Name="Placeholder"
                                           Margin="34,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"
                                           Text="Search running apps" />
                                <!-- TextBox applies Padding to the content host itself; binding it here too doubles it -->
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Slider: filled track, thumb that reacts on hover and press ===== -->
        <Style x:Key="SliderTrackButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <!-- transparent grid keeps the full height clickable -->
                        <Grid Background="Transparent">
                            <Border Height="4"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid>
                            <Ellipse Fill="{DynamicResource ThumbBrush}"
                                     Stroke="{DynamicResource ThumbBorderBrush}"
                                     StrokeThickness="1" />
                            <Ellipse Width="12"
                                     Height="12"
                                     Fill="{DynamicResource AccentBrush}"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="InnerScale" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="InnerScale" Storyboard.TargetProperty="ScaleX" To="1.17" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="InnerScale" Storyboard.TargetProperty="ScaleY" To="1.17" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="InnerScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="InnerScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- Thumb starts dragging on mouse-down, so this is press feedback -->
                            <Trigger Property="IsDragging" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="InnerScale" Storyboard.TargetProperty="ScaleX" To="0.83" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="InnerScale" Storyboard.TargetProperty="ScaleY" To="0.83" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="InnerScale" Storyboard.TargetProperty="ScaleX" To="1.17" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="InnerScale" Storyboard.TargetProperty="ScaleY" To="1.17" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="32" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="10" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                            <Border Height="4"
                                    CornerRadius="2"
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource TrackBrush}" />
                            <Track x:Name="PART_Track" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Style="{StaticResource SliderTrackButtonStyle}"
                                                  Background="{DynamicResource AccentBrush}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource SliderTrackButtonStyle}"
                                                  Background="Transparent" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Scrollbars: slim, no arrows ===== -->
        <Style x:Key="ScrollPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Margin="3" CornerRadius="2" Background="{DynamicResource ScrollThumbBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- lists disable horizontal scrolling; this only keeps a stray one sane -->
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Track x:Name="PART_Track" Orientation="Horizontal">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumbStyle}" />
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Lists ===== -->
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <ScrollViewer Focusable="False"
                                      Padding="{TemplateBinding Padding}"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- sidebar rows: Fluent navigation look, with an accent pill on the selected row -->
        <Style x:Key="NavItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="12,0,10,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" SnapsToDevicePixels="True">
                            <Grid>
                                <Rectangle x:Name="Pill"
                                           Width="3"
                                           Height="16"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           HorizontalAlignment="Left"
                                           Fill="{DynamicResource AccentBrush}"
                                           Visibility="Collapsed" />
                                <ContentPresenter x:Name="Content"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedFillBrush}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource SelectedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- picker rows: highlight on press, add on release -->
        <Style x:Key="PickerItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <EventSetter Event="MouseLeftButtonUp" Handler="ProcessItem_MouseLeftButtonUp" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VibranceBadge" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="BadgeText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <DataTemplate DataType="{x:Type vm:DesktopEntry}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IconText}" Text="&#xE7F4;" />
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding Name}" />
                <Border Grid.Column="2" Style="{StaticResource VibranceBadge}">
                    <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Vibrance}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ProgramProfile}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="16"
                       Height="16"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="{Binding Icon}" />
                <!-- generic app glyph when the exe has no icon (or has moved) -->
                <!-- Collapsed via a style setter, not an attribute: a local value would beat the trigger -->
                <TextBlock Text="&#xE7C3;">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource IconText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Name}" />
                <Border Grid.Column="2" Style="{StaticResource VibranceBadge}">
                    <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Vibrance}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ===== Surfaces ===== -->
        <Style x:Key="SettingsCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <DropShadowEffect x:Key="FlyoutShadow" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black" />
    </Window.Resources>

    <Border x:Name="RootBorder"
            BorderThickness="1"
            BorderBrush="{DynamicResource LayerBorderBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Title bar: part of the window surface, dragged natively by WindowChrome ===== -->
            <StackPanel Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
                <Image Source="pack://application:,,,/ui/Assets/logo.ico"
                       Width="16"
                       Height="16"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="NVibrance" />
            </StackPanel>

            <StackPanel Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButtonStyle}"
                        Content="&#xE921;"
                        ToolTip="Minimize"
                        AutomationProperties.Name="Minimize"
                        Click="Minimize_Click" />
                <Button x:Name="MaximizeButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        Content="&#xE922;"
                        ToolTip="Maximize"
                        AutomationProperties.Name="Maximize"
                        Click="Maximize_Click" />
                <Button Style="{StaticResource CloseCaptionButtonStyle}"
                        Content="&#xE8BB;"
                        ToolTip="Close (NVibrance keeps running in the tray)"
                        AutomationProperties.Name="Close"
                        Click="Close_Click" />
            </StackPanel>

            <!-- ===== Sidebar ===== -->
            <Grid Grid.Row="1" Grid.Column="0" Margin="8,4,8,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="EntriesList"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         AutomationProperties.Name="Profiles"
                         KeyDown="EntriesList_KeyDown"
                         MouseDoubleClick="EntriesList_MouseDoubleClick" />

                <!-- empty state, shown under the Desktop row until a profile exists -->
                <TextBlock Margin="12,52,12,0"
                           VerticalAlignment="Top"
                           TextWrapping="Wrap"
                           IsHitTestVisible="False"
                           Text="No profiles yet. Add a game to give it its own vibrance.">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CaptionText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasProfiles}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- pause is set from the tray; the window says so, and offers the way back -->
                <Border Grid.Row="1"
                        Margin="0,8,0,0"
                        Padding="12,6,6,6"
                        Style="{StaticResource SettingsCard}"
                        Visibility="{Binding IsSwitchingPaused, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongText}" FontSize="12" Text="Switching paused" />
                            <TextBlock Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" Text="Desktop value in use" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource SubtleButtonStyle}"
                                Foreground="{DynamicResource AccentBrush}"
                                FontWeight="SemiBold"
                                Content="Resume"
                                Click="ResumeSwitching_Click" />
                    </Grid>
                </Border>

                <Button x:Name="AddButton"
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Add program"
                        Click="AddButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE710;" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Add program" />
                    </StackPanel>
                </Button>

                <!-- the picker grows up and out of the button that opened it -->
                <Popup x:Name="AddPopup"
                       PlacementTarget="{Binding ElementName=AddButton}"
                       Placement="Top"
                       VerticalOffset="-2"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       Opened="AddPopup_Opened"
                       Closed="AddPopup_Closed">
                    <Border x:Name="AddPopupContent"
                            Margin="12"
                            Width="320"
                            Padding="6"
                            Background="{DynamicResource PopupBrush}"
                            BorderBrush="{DynamicResource PopupBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Effect="{StaticResource FlyoutShadow}"
                            RenderTransformOrigin="0,1">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="AddPopupScale" />
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="260" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBox x:Name="ProcessSearch"
                                     Margin="2,2,2,6"
                                     Style="{StaticResource SearchBoxStyle}"
                                     AutomationProperties.Name="Search running apps"
                                     TextChanged="ProcessSearch_TextChanged"
                                     PreviewKeyDown="ProcessSearch_PreviewKeyDown" />

                            <ListBox x:Name="ProcessList"
                                     Grid.Row="1"
                                     ItemContainerStyle="{StaticResource PickerItemStyle}"
                                     AutomationProperties.Name="Running apps"
                                     KeyDown="ProcessList_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:RunningProgram}">
                                        <DockPanel>
                                            <Image Width="16"
                                                   Height="16"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Source="{Binding Icon}" />
                                            <TextBlock Margin="12,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="EmptyProcessesText"
                                       Grid.Row="1"
                                       Margin="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionText}"
                                       Visibility="Collapsed"
                                       Text="No matching apps with a window are running. Browse for the .exe instead." />

                            <Border Grid.Row="2" Height="1" Margin="-6,6" Background="{DynamicResource PopupBorderBrush}" />

                            <Button Grid.Row="3"
                                    HorizontalContentAlignment="Left"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    AutomationProperties.Name="Browse for an .exe"
                                    Click="BrowseExe_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE838;" />
                                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Browse for an .exe…" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>

            <!-- ===== Detail: a lighter layer over the window surface ===== -->
            <Border Grid.Row="1"
                    Grid.Column="1"
                    Background="{DynamicResource LayerBrush}"
                    BorderBrush="{DynamicResource LayerBorderBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0">
                <Grid>
                    <!-- capped so a maximized window stays scannable -->
                    <Grid Margin="32,28,32,24" MaxWidth="1000">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Image Width="32"
                                   Height="32"
                                   VerticalAlignment="Top"
                                   Margin="0,6,0,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{Binding SelectedProfile.Icon}"
                                   Visibility="{Binding IsProfileSelected, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource IconText}"
                                       VerticalAlignment="Top"
                                       Margin="0,6,0,0"
                                       FontSize="28"
                                       Text="&#xE7F4;"
                                       Visibility="{Binding IsDesktopSelected, Converter={StaticResource BoolToVisibility}}" />
                            <!-- generic app glyph when the profile's exe has no icon (or has moved) -->
                            <TextBlock VerticalAlignment="Top"
                                       Margin="0,6,0,0"
                                       FontSize="28"
                                       Text="&#xE7C3;">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource IconText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsProfileSelected}" Value="True" />
                                                    <Condition Binding="{Binding SelectedProfile.Icon}" Value="{x:Null}" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <!-- left-aligned with a star column: the name sizes to its text but
                                     is capped by the pane, so a long name never pushes the pencil out -->
                                <Grid HorizontalAlignment="Left"
                                      Visibility="{Binding IsProfileSelected, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NameBox"
                                             Style="{StaticResource TitleEditBoxStyle}"
                                             Text="{Binding SelectedProfile.Name, Mode=OneWay}"
                                             AutomationProperties.Name="Profile name"
                                             KeyDown="NameBox_KeyDown"
                                             LostKeyboardFocus="NameBox_LostKeyboardFocus" />
                                    <Button Grid.Column="1"
                                            Margin="4,0,0,0"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            ToolTip="Rename (F2)"
                                            AutomationProperties.Name="Rename profile"
                                            Click="Rename_Click">
                                        <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE70F;" />
                                    </Button>
                                </Grid>
                                <!-- bottom margin matches the name box's focus underline, so the
                                     caption below doesn't shift when switching rows -->
                                <TextBlock Style="{StaticResource TitleText}"
                                           Margin="0,0,0,2"
                                           Text="Desktop"
                                           Visibility="{Binding IsDesktopSelected, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Style="{StaticResource CaptionText}"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding SelectedProfile.ExecutablePath}"
                                           ToolTip="{Binding SelectedProfile.ExecutablePath}"
                                           Visibility="{Binding IsProfileSelected, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Margin="0,2,0,0"
                                           Text="Used whenever the focused app has no profile."
                                           Visibility="{Binding IsDesktopSelected, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>

                        <!-- vibrance -->
                        <Border Grid.Row="2" Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <!-- "Saved" sits beside the title, where there is room to spare, so it
                                         never takes width from the caption below -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BodyStrongText}" Text="Vibrance" />
                                        <StackPanel x:Name="SavedIndicator"
                                                    Orientation="Horizontal"
                                                    Margin="10,0,0,0"
                                                    Opacity="0"
                                                    IsHitTestVisible="False">
                                            <TextBlock Style="{StaticResource IconText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SuccessBrush}"
                                                       Text="&#xE73E;" />
                                            <TextBlock Margin="4,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SuccessBrush}"
                                                       Text="Saved" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource CaptionText}"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding IsProfileSelected, Converter={StaticResource BoolToVisibility}}">
                                        <Run Text="Applied while" />
                                        <Run Text="{Binding SelectedProfile.Name, Mode=OneWay}" />
                                        <Run Text="is in focus." />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CaptionText}"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Text="Applies to your primary display immediately."
                                               Visibility="{Binding IsDesktopSelected, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource DangerBrush}"
                                               Text="No active NVIDIA display found, so vibrance can't be changed right now.">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDisplay}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <Slider Grid.Column="1"
                                        Width="240"
                                        IsEnabled="{Binding HasDisplay}"
                                        Minimum="{Binding SliderMin}"
                                        Maximum="{Binding SliderMax}"
                                        Value="{Binding DetailVibrance, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="Vibrance" />

                                <TextBlock Grid.Column="2"
                                           MinWidth="36"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           FontWeight="SemiBold"
                                           Typography.NumeralAlignment="Tabular"
                                           Text="{Binding DetailVibrance}" />
                            </Grid>
                        </Border>

                        <!-- remove -->
                        <Border Grid.Row="4"
                                Style="{StaticResource SettingsCard}"
                                Visibility="{Binding IsProfileSelected, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource BodyStrongText}" Text="Remove profile" />
                                    <TextBlock Style="{StaticResource CaptionText}"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Text="NVibrance stops changing vibrance for this app. You can undo this." />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Content="Delete"
                                        ToolTip="Delete profile (Del)"
                                        Click="DeleteProfile_Click" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- undo toast: rises from the bottom edge and leaves the same way -->
                    <Border x:Name="UndoToast"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,24"
                            Padding="16,6,6,6"
                            Background="{DynamicResource PopupBrush}"
                            BorderBrush="{DynamicResource PopupBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Effect="{StaticResource FlyoutShadow}"
                            Opacity="0"
                            Visibility="Collapsed"
                            MouseEnter="UndoToast_MouseEnter"
                            MouseLeave="UndoToast_MouseLeave">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="UndoToastOffset" />
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UndoText" VerticalAlignment="Center" />
                            <Button Margin="16,0,0,0"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Foreground="{DynamicResource AccentBrush}"
                                    FontWeight="SemiBold"
                                    Content="Undo"
                                    ToolTip="Undo (Ctrl+Z)"
                                    Click="Undo_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
